# /etc/fedora-cosmic-atomic/nightly.env — settings for cosmic-nightly (spec J1).
# Copy here during the migration, fill in, then: chmod 600, owner root.
# Without this file the job still runs the drift report and the upgrades.

NIGHTLY_USER="me"                                    # whose home is backed up

# S2a: plain-file snapshots; skipped when this directory is absent (DAS not attached).
LOCAL_SNAPSHOT_DIR="/run/media/${NIGHTLY_USER}/DAS/frmwrk-snapshots"
LOCAL_KEEP_DAILY=7
LOCAL_KEEP_WEEKLY=4
LOCAL_KEEP_MONTHLY=12
# VM disk images are copied separately (when changed and the VM is off; last 2 kept).
VM_IMAGE_DIRS="/var/lib/libvirt/images /var/lib/libvirt/vm-images"

# S2b: the off-site copy is deferred until the migration has settled (your call when).
# While this is set, the job skips B2 and every report says since when; cosmic-acceptance
# shows the B2 checks as DEFERRED and counts the DAS copy alone. Remove the line (and fill
# in the settings below) to end the deferral: the next night uploads to B2.
OFFSITE_DEFERRED=1

# S2b: restic, encrypted before upload. Use the bucket key that cannot delete;
# prune by hand with the admin key. S2f: one repository for every machine, at a path
# that names no machine (snapshots are told apart by --host); a second machine joins
# it with `restic key add`, never a second `restic init`.
RESTIC_REPOSITORY="b2:bucket-name:restic"
# or B2's S3-compatible endpoint, which restic's docs recommend; then the key goes in
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead of B2_ACCOUNT_ID / B2_ACCOUNT_KEY:
#RESTIC_REPOSITORY="s3:s3.<region>.backblazeb2.com/bucket-name/restic"
#AWS_ACCESS_KEY_ID=""
#AWS_SECRET_ACCESS_KEY=""
RESTIC_PASSWORD_FILE="/etc/fedora-cosmic-atomic/restic-offsite.pass"
B2_ACCOUNT_ID=""
B2_ACCOUNT_KEY=""
# A target without ACL/xattr support (some NAS, over ssh): RSYNC_FLAGS="-aH"
# R1: a copy older than this many hours is stale; the hourly catch-up then retries it.
#BACKUP_MAX_AGE_H=24
