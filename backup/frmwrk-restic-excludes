# restic exclude file for the Framework 13 backup.
# Patterns are ANCHORED (absolute). An unanchored "build/" would match any
# directory called build anywhere under ~, including real project data.
# $BACKUP_HOME is the backed-up home (/home/<user>); frmwrk_backup_command.sh
# exports it and restic expands it here.
# Check the effect with:  restic ls latest | grep -E '/(build|dist|target)/'

# ─── Cache and temp (regenerable) ───
$BACKUP_HOME/.cache
$BACKUP_HOME/.thumbnails
$BACKUP_HOME/.local/share/Trash
$BACKUP_HOME/.local/share/recently-used.xbel
$BACKUP_HOME/.local/share/tracker
$BACKUP_HOME/.local/share/tracker3
$BACKUP_HOME/.npm
$BACKUP_HOME/.var/app/*/cache

# ─── Browser caches (profiles are kept) ───
$BACKUP_HOME/.mozilla/firefox/*/cache2
$BACKUP_HOME/.mozilla/firefox/*/startupCache
$BACKUP_HOME/.var/app/org.mozilla.firefox/cache
$BACKUP_HOME/.var/app/app.zen_browser.zen/cache

# ─── VMs: ISOs and the duplicate eval VM ───
$BACKUP_HOME/Downloads/WinDev2407Eval.VirtualBox
$BACKUP_HOME/Downloads/WinDev2407Eval.VirtualBox.zip
$BACKUP_HOME/Downloads/*.iso
$BACKUP_HOME/VMs/*.iso

# ─── Hermes runtime (agent install + cache — regenerable) ───
$BACKUP_HOME/.hermes/cache
$BACKUP_HOME/.hermes/tools
$BACKUP_HOME/.hermes/installs
$BACKUP_HOME/.hermes/lsp
$BACKUP_HOME/.hermes/bin
$BACKUP_HOME/.hermes/models_dev_cache.json

# ─── Build artefacts and virtual environments (anywhere under ~, by exact name) ───
$BACKUP_HOME/**/node_modules
$BACKUP_HOME/**/.venv
$BACKUP_HOME/**/venv
$BACKUP_HOME/**/__pycache__
$BACKUP_HOME/**/*.egg-info
*.pyc
# Rust/Java/JS output dirs are NOT excluded any more — too easy to lose a real
# folder named build/dist/target. Add specific project paths here if needed.

# ─── Wine prefixes, rootless podman storage (images are re-pullable) ───
$BACKUP_HOME/.wine
$BACKUP_HOME/.local/share/containers/storage

# ─── Syncthing: logs and the rebuildable index (identity + config stay IN) ───
$BACKUP_HOME/.local/state/syncthing/*.log
$BACKUP_HOME/.local/state/syncthing/index-v2
